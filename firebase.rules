rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/{document=**} {
      allow read: if true;
      // المشروع الحالي يعتمد على صلاحيات الواجهة، لذلك هذه القاعدة مناسبة للتجربة فقط.
      // قبل النشر العام يجب تشديد الصلاحيات لمنع العبث ببيانات المستخدمين والتطبيقات.
      allow write: if request.auth != null;
    }
  }
}
